# =============================================================================
# .gitignore — Cardiopatias Congênitas e Adquiridas
# =============================================================================

# --- Ambiente R / RStudio ------------------------------------------------
.Rhistory
.Rapp.history
.RData
.Ruserdata
.Rproj.user
*.Rproj

# IDE RStudio instalada localmente (NÃO faz parte do repositório)
RStudio/

# --- Cache de downloads e processamento (regenerável) ---------------------
data/cache/

# --- Saídas intermediárias do R ------------------------------------------
Rplots*.png

# --- Sistema operacional --------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# --- Dados sensíveis / locais --------------------------------------------
*.key
*.secret
.env
credentials*

# --- Python (caso venha a ser usado) -------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/
